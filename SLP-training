#parameters
learning_rate = 0.1
epochs = 5

bias = 0.5
weights = np.array([0.5, 0.5, 0.5, 0.5], dtype=float)

#sigmoid function
def sigmoid(z):
    return 1 / (1 + np.exp(-z))

#training
accuracy_history = []
loss_history = []

for epoch in range(epochs):

    correct_predictions = 0
    squared_errors = []

    z_first = bias + np.dot(weights, X[0])
    output_first = sigmoid(z_first)

    bias_gradient = (
        2
        * (output_first - y[0])
        * (1 - output_first)
        * output_first
    )

    for i in range(len(X)):

        z = bias + np.dot(weights, X[i])

        output = sigmoid(z)

        prediction = 1 if output > 0.5 else 0

        error = output - y[i]

        squared_errors.append(error ** 2)

        if prediction == y[i]:
            correct_predictions += 1

        gradient = (
            2
            * error
            * (1 - output)
            * output
        )

        bias = bias - learning_rate * bias_gradient

        weights = weights - learning_rate * gradient * X[i]

    accuracy = correct_predictions / len(X)

    loss = np.mean(squared_errors)

    accuracy_history.append(accuracy * 100)
    loss_history.append(loss)

    print(f"epoch {epoch + 1}")
    print(f"accuracy: {accuracy * 100:.2f}%")
    print(f"loss: {loss:.10f}")
    print(f"bias: {bias:.10f}")
    print(f"weights: {weights}")
    print("-" * 60)


print("\nfinal training results")
